# IntelliJ / Android Studio specific files & folders
*.iml
/.idea/caches/
/.idea/libraries/
/.idea/modules.xml
/.idea/workspace.xml
/.idea/navEditor.xml
/.idea/assetWizardSettings.xml
/.idea/deploymentTargetSelector.xml
/.idea/deploymentTargetDropDown.xml
/.idea/deviceManager.xml
/.idea/androidTestResultsUserPreferences.xml
/.idea/planningMode.xml
/.idea/studiobot.xml
/.idea/gradle.xml
/.idea/misc.xml
/.idea/compiler.xml
/.idea/kotlinc.xml

# Generated Eclipse / Buildship project metadata
/.project
/.settings/
/app/.project
/app/.classpath
/app/.settings/

# Gradle
.gradle/
.kotlin/

# Local configuration - Never commit this
/local.properties

# Build output
/build/
/app/build/
/app/bin/
/.outputs/
*.apk
*.aab

# Keystore files - Never commit these as they contain signing keys
*.jks
*.keystore

# Android Studio profiling data
*.hprof
*.prof
*.snap
*.snapshot

# Lint results
lint-results.txt
lint-results-*.xml
lint-results-*.html

# OS specific
.DS_Store

# Captures (e.g. from Emulator)
/captures/

# Native build temporary files
.externalNativeBuild/
.cxx/
